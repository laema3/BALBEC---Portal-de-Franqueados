{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "paomania.com.br"
        }
      ],
      "destination": "https://cardapiodigital.paomania.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.paomania.com.br"
        }
      ],
      "destination": "https://cardapiodigital.paomania.com.br/$1",
      "permanent": true
    }
  ]
}
